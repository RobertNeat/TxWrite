{
  "name": "LaTEX_Markdown_Editor",
  "private": true,
  "packageManager": "pnpm@11.28.11",
  "scripts": {
    "dev:backend": "pnpm --filter backend start:dev",
    "dev:frontend": "pnpm --filter frontend start",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "pnpm -r run format",
    "format:check": "pnpm -r run format:check",
    "test": "pnpm -r run test",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run test",
    "check": "pnpm run verify && pnpm run build"
  }
}
