# Production config.env template, copied to the remote host ONLY on first
# deploy (see .github/steps/deploy_compose_ssh.sh) — an existing remote
# config.env is never overwritten, so values changed here afterwards must be
# applied on the server by hand.
#
# JWT_SECRET is intentionally left empty, unlike the repo-root .env.example:
# that file's placeholder is a valid (>=32 char) value, which would let the
# backend boot on an unchanged, publicly-known secret in production. Set a
# real one before (or right after) the first deploy — the app refuses to
# start without it.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Deployment is plain HTTP on the LAN (http://192.168.1.160:10800, see
# .github/ci/projects.json). Set to true only once the app is served over
# HTTPS (e.g. behind a reverse proxy with TLS).
COOKIE_SECURE=false

# Same-origin deployment (frontend served by the backend on the same host:port),
# so no extra Origin allowlisting is needed here — see
# apps/backend/src/modules/auth/auth.guard.ts.
# EXTRA_ALLOWED_ORIGINS=

# --- registration SMTP email confirmation (optional; leave unset to disable)
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=smtp-user
# SMTP_PASS=smtp-password
MAIL_FROM=no-reply@localhost

# --- compile and fetch tunables
PREFETCH_DELAY_MS=4000
COMPILE_TIMEOUT_MS=60000
COMPILE_RETRY_BUDGET_MS=120000
NETWORK_FETCH=true
