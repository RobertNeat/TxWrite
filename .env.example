# Single repo-root env file — copy to `.env` (or `.env.local`, loaded second
# so it can override `.env`) and fill in real values. Never commit the real
# file; only this .env.example is tracked (see .gitignore).
#
# Used by BOTH:
#   - the backend run directly (`pnpm --filter backend start:dev`, or any
#     other CWD) — apps/backend/src/common/config/app-config.module.ts
#     resolves this file relative to the repo root, not process.cwd(), so it
#     is found the same way no matter where you launch the backend from.
#   - Docker Compose (`docker compose -f deploy/docker-compose.yml up`) —
#     deploy/docker-compose.yml's `env_file: ../.env` loads this same file
#     into the container's environment.
#
# IMPORTANT: inside docker-compose.yml's `environment:` block, a handful of
# keys are intentionally re-set to container-specific values (HOST, PORT,
# DATA_DIR, CACHE_DIR, PACKAGE_INDEX_PATH, TEX_REPO_URL) and will silently
# win over whatever you put here — `environment:` always overrides
# `env_file`. Those are host-filesystem/network values for your machine and
# make no sense inside the container's own namespace, so this is deliberate,
# not a bug; see the comments in deploy/docker-compose.yml. Everything else
# below (JWT_*, COOKIE_SECURE, EXTRA_ALLOWED_ORIGINS, PREFETCH_DELAY_MS,
# COMPILE_TIMEOUT_MS, NETWORK_FETCH) really is shared — change it here once
# and both local dev and Docker pick it up.
#
# TEX_REPO_URL/TL_SNAPSHOT_KEY used at *image build time* (install-tl itself)
# are a separate concern: they're Docker build ARGs pinned directly in
# deploy/docker-compose.yml, not read from this file, because build-arg
# interpolation can't see env_file-loaded variables — only a real top-level
# .env next to the compose invocation or the shell environment can feed
# ${...} substitution. Keep the TEX_REPO_URL value below in sync with that
# pinned build arg if you ever change the snapshot date.

# ---- Shared by local dev and Docker ----

# Auth (JWT access/refresh cookies). JWT_SECRET must be >= 32 chars; generate
# with e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`.
# The backend refuses to start without it — never commit a real secret here,
# this file only documents the shape.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Secure cookies are dropped over plain HTTP — this defaults to false because
# neither `ng serve` nor the default docker-compose.yml terminate TLS. Set to
# true once a reverse proxy in front of the app is doing HTTPS (see
# docs/project_assumptons/architecture.md section 8).
COOKIE_SECURE=false
# Comma-separated Origin values to accept on mutating requests in addition to
# same-Host ones. Needed for `ng serve`'s dev proxy (proxy.conf.json), which
# rewrites Host via changeOrigin but leaves the browser's Origin as the dev
# server's own origin:
# EXTRA_ALLOWED_ORIGINS=http://localhost:4200

PREFETCH_DELAY_MS=4000
COMPILE_TIMEOUT_MS=60000
# Total time budget for the reactive package-install retry loop (architecture.md
# section 5.3) — not a fixed iteration count, since a template can need many
# packages resolved one miss at a time.
COMPILE_RETRY_BUDGET_MS=120000
NETWORK_FETCH=true

# ---- Local dev only (ignored in Docker — deploy/docker-compose.yml's
#      `environment:` block always overrides these for the container) ----

PORT=3000
HOST=127.0.0.1
# Relative to wherever the backend process's CWD ends up (apps/backend when
# run via `pnpm --filter backend start:dev`), NOT relative to the repo root.
DATA_DIR=./.local-data/data
CACHE_DIR=./.local-data/cache
# Frozen dated snapshot, not a rolling mirror — see
# docs/project_assumptons/architecture.md section 6.6. Must match the
# TEX_REPO_URL/TL_SNAPSHOT_KEY build args pinned in deploy/docker-compose.yml.
TEX_REPO_URL=https://texlive.info/tlnet-archive/2026/10/01/tlnet/
# Path to the gzipped file->package index built at image build time
# (deploy/docker/build-package-index.pl). Only needs overriding for local dev
# outside the container, where the file won't exist — Docker always sets its
# own value via `environment:`.
PACKAGE_INDEX_PATH=/opt/app/package-index.json.gz
