# --- OCI image labels (read by .github/steps/create_docker_image.sh at build
# time only; not consumed by the app itself)
IMAGE_TITLE=TxWrite
IMAGE_DESCRIPTION=Browser-based LaTeX/Markdown editor with a bundled TeX Live + pandoc toolchain
IMAGE_VENDOR=RobertNeat
IMAGE_LICENSES=UNLICENSED
IMAGE_SOURCE=https://github.com/RobertNeat/LaTEX_Markdown_Editor

# --- auth (JWT access/refresh cookies)
# JWT_SECRET - signing key, text, >= 32 chars
# JWT_ACCESS_TTL_SECONDS - access token lifetime, seconds
# JWT_REFRESH_TTL_DAYS - refresh token lifetime, days
# COOKIE_SECURE - send cookies only over HTTPS, boolean
# EXTRA_ALLOWED_ORIGINS - extra allowed Origin values, comma-separated text
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
# EXTRA_ALLOWED_ORIGINS=http://localhost:4200

# --- registration SMTP email confirmation
# SMTP_HOST - domain of the SMTP server, text
# SMTP_PORT - SMTP server port, number
# SMTP_SECURE - use implicit TLS, boolean
# SMTP_USER - SMTP auth username, text
# SMTP_PASS - SMTP auth password, text
# MAIL_FROM - From address on outgoing emails, text
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=smtp-user
# SMTP_PASS=smtp-password
MAIL_FROM=no-reply@localhost

# --- compile and fetch tunables
# PREFETCH_DELAY_MS - prefetch delay, milliseconds
# COMPILE_TIMEOUT_MS - compile timeout, milliseconds
# COMPILE_RETRY_BUDGET_MS - package-install retry budget, milliseconds
# NETWORK_FETCH - allow network fetching, boolean
PREFETCH_DELAY_MS=4000
COMPILE_TIMEOUT_MS=60000
COMPILE_RETRY_BUDGET_MS=120000
NETWORK_FETCH=true

# --- local dev only (ignored in Docker)
# PORT - backend listen port, number
# HOST - backend bind interface, text
# DATA_DIR - data directory, path
# CACHE_DIR - cache directory, path
# TEX_REPO_URL - TeX Live mirror URL, text
# PACKAGE_INDEX_PATH - package index file path, path
PORT=10800
HOST=127.0.0.1
DATA_DIR=./.local-data/data
CACHE_DIR=./.local-data/cache
TEX_REPO_URL=https://texlive.info/tlnet-archive/2026/10/01/tlnet/
PACKAGE_INDEX_PATH=/opt/app/package-index.json.gz
